# Warden 环境变量示例 —— 复制为 .env（或直接在 shell 里 export）。
# config.py 会优先加载 .env（不覆盖已存在的环境变量）。

# ---- LLM（OpenAI 兼容接口）----
# 本地 Ollama（默认）：
WARDEN_LLM_BASE_URL=http://localhost:11434/v1
WARDEN_LLM_API_KEY=ollama
WARDEN_LLM_MODEL=qwen2.5:7b

# 切换到 OpenAI：
# WARDEN_LLM_BASE_URL=https://api.openai.com/v1
# WARDEN_LLM_API_KEY=sk-xxxxxxxx
# WARDEN_LLM_MODEL=gpt-4o-mini

WARDEN_LLM_TEMPERATURE=0
WARDEN_LLM_TIMEOUT_S=120

# ---- Agent 循环 ----
WARDEN_AGENT_MAX_STEPS=10

# ---- API ----
WARDEN_API_HOST=127.0.0.1
WARDEN_API_PORT=8000

# ---- 调度与任务（M1）----
# 通知方式：console（打印）| file（写 reports/ 目录）
WARDEN_NOTIFY_KIND=console
WARDEN_REPORT_DIR=reports
WARDEN_DATA_DIR=data

# 资讯/论文简报：RSS/Atom 源，逗号分隔
WARDEN_RSS_SOURCES=https://news.ycombinator.com/rss,https://export.arxiv.org/rss/cs.AI

# 每周复盘：个人笔记目录（Markdown），留空则跳过笔记部分
WARDEN_NOTES_DIR=

# 代码库维护助手：要扫描的仓库路径（. 表示当前目录）
WARDEN_REPO_PATH=.
